# simple calculator function

def calculator(a,b,operator):
    if operator =="+":
        return a+b
    elif operator =="-":
        return a-b
    elif operator=="*":
        return a*b
    elif operator=="/":
        return a/b
    else:
        return "invalid operator"

num1=int(input("Enter first number: "))
num2=int(input("Enter second number: "))
operator_=input("Enter an operator (+,-,*,/): ")

result = calculator(num1,num2,operator_)
print(result)

# prime nubmer check

def prime_check(numbers):
    if numbers<2:
        return "Not prime"
    for i in range(2,numbers):
        if numbers%i==0:
            return "Not Prime"
    return "Prime Number"

num = int(input("Enter num: "))
result = prime_check(num)
print(result)


