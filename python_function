# find max value

def my_function(*numbers):
    total=0
    if len(numbers)==0:
        return None

    max_num=numbers[0]
    for num in numbers:
        if num > max_num:
            max_num=num
    return max_num

print("max num" ,my_function(5,2,7,9))


